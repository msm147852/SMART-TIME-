# SMART AI is keyless in V1; no cloud AI provider key is required.
# Optional local inference adapter (no API key):
# SMART_AI_LOCAL_URL=http://127.0.0.1:11434
# SMART_AI_LOCAL_MODEL=smart-time-local
# SMART_AI_LOCAL_TOKEN=replace-with-a-long-random-secret

# Football / Sports Fixtures (Either RapidAPI or API-Football)
RAPIDAPI_KEY=
API_FOOTBALL_KEY=

# Live News Service
GNEWS_API_KEY=

# Routing & Geocoding (Mapbox / Google Maps / TomTom)
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
TOMTOM_API_KEY=

# Client Map Tiles (MapTiler)
VITE_MAPTILER_API_KEY=

# SMS & Verification Providers (Twilio / MessageCentral / Webhook)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_KEY=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=

# Email Provider (Resend)
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=

# App Administration & Payment Defaults
PROGRAM_OWNER_EMAIL=
PROGRAM_OWNER_USER_ID=
PROGRAM_OWNER_ACTIVATION_KEY=
OWNER_WALLET_NUMBER=01126621962
OWNER_INSTAPAY_ADDRESS=01126621962
TRIP_SEARCH_COST_EGP=5
WALLET_TOPUP_MIN_EGP=5
WALLET_TOPUP_MAX_EGP=10000

# Optional local SMART VOICE DNA GPU provider (self-hosted; disabled when empty)
# SMART_VOICE_DNA_PROVIDER_URL=http://127.0.0.1:8000/synthesize
# SMART_VOICE_DNA_PROVIDER_TOKEN=replace-with-a-long-random-secret
# SMART_VOICE_DNA_PROVIDER_TIMEOUT_MS=120000
# SMART_VOICE_DNA_MAX_REFERENCE_BYTES=8388608

# Optional Voice DNA synthesis protection
# SMART_VOICE_DNA_MAX_REQUESTS_PER_MINUTE=8
