API_FOOTBALL_KEY=
CAREEM_API_KEY=
DIDI_API_KEY=
GEMINI_API_KEY=
GNEWS_API_KEY=
GOOGLE_MAPS_API_KEY=
INDRIVE_API_KEY=
# مفتاح Mapbox (اختياري - ملحوظة: Mapbox بيطلب ربط وسيلة دفع عند التسجيل حتى لو الاستخدام
# هيفضل مجاني. لو مش عايز تربط وسيلة دفع خالص، سيب المتغير ده فاضي والسيرفر هيستخدم
# تلقائيًا OpenStreetMap Nominatim كبديل مجاني تمامًا وبدون أي تسجيل)
MAPBOX_ACCESS_TOKEN=
PROGRAM_OWNER_ACTIVATION_KEY=
PROGRAM_OWNER_EMAIL=
PROGRAM_OWNER_USER_ID=

# إعدادات محفظة SMART TIME
TRIP_SEARCH_COST_EGP=5
WALLET_TOPUP_MIN_EGP=5
WALLET_TOPUP_MAX_EGP=10000
OWNER_WALLET_NUMBER=
OWNER_INSTAPAY_ADDRESS=
SMS_PROVIDER=
SMS_WEBHOOK_SECRET=
SMS_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# بديل لـ Twilio لا يحتاج بطاقة ائتمان: Message Central (VerifyNow) - سجل مجانًا على
# https://console.messagecentral.com/signup واحصل على customerId ومفتاح (key) من لوحة التحكم.
# استخدم SMS_PROVIDER=messagecentral وفعّل المتغيرين التاليين بدلًا من متغيرات Twilio:
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_KEY=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
VITE_GOOGLE_MAPS_API_KEY=

# رابط الباك اند الكامل - سيبه فاضي لو الفرونت اند والباك اند شغالين على نفس الدومين
# (زي Vercel أو أي استضافة عادية). لازم تحطه لو بتبني تطبيق أندرويد بـ Capacitor
# أو لو الفرونت اند مستضاف على دومين منفصل عن الباك اند.
# مثال: VITE_API_URL=https://smart-time-api.up.railway.app
VITE_API_URL=
# إعدادات البريد الإلكتروني لاستعادة كلمة المرور
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALLOW_DEV_EMAIL_CODE=false

# البريد الإلكتروني لاستعادة كلمة المرور (إرسال حقيقي)
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
# للتجربة المحلية فقط: true يعرض رمزًا في الواجهة بدل الإرسال الفعلي
ALLOW_DEV_EMAIL_CODE=false
