# Live news (GNews)
# Create a free API key at https://gnews.io/
GNEWS_API_KEY=

# Live football scores (API-Football / API-Sports)
# Free plan currently includes 100 requests/day.
API_FOOTBALL_KEY=

# Optional: Google Gemini key already used by the AI layer if your deployment needs it.
GEMINI_API_KEY=

# V8 backend foundation
PORT=3000
# Never expose provider secrets in VITE_* variables.
# Transport provider credentials belong here only after official API access is approved.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
CAREEM_API_KEY=
INDRIVE_API_KEY=
DIDI_API_KEY=

# Program owner activation
PROGRAM_OWNER_EMAIL=eng.mamdouh2009@gmail.com
# Set a strong secret on the server; never expose it in VITE_* variables.
PROGRAM_OWNER_ACTIVATION_KEY=CHANGE_ME
# SMS provider (required for production phone verification)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Alternative: SMS_PROVIDER=webhook
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=
