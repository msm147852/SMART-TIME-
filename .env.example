# SMART TIME server secrets
GEMINI_API_KEY=
RAPIDAPI_KEY=

# Password-reset email provider (server-side only)
# Use development only outside production; it returns the OTP in the API response.
EMAIL_PROVIDER=development
ALLOW_DEV_EMAIL_CODE=true

# Gmail SMTP: use a Google App Password, never the normal Gmail password.
# EMAIL_PROVIDER=gmail
# EMAIL_FROM=your-app@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-app@gmail.com
# SMTP_PASS=your-16-character-app-password

# Alternative providers
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=
